---
permalink: /_redirects
eleventyAllowMissingExtension: true
eleventyExcludeFromCollections: true
---
# Old Google Sites URLs → new pages (301); short links (302)
{%- for r in collections.redirects %}
{{ r.from }}  {{ r.to }}  {{ r.status or 301 }}
{{ r.from }}/  {{ r.to }}  {{ r.status or 301 }}
{%- set enc = r.from | urlencode | replace("%2F", "/") %}
{%- if enc != r.from %}
{{ enc }}  {{ r.to }}  {{ r.status or 301 }}
{{ enc }}/  {{ r.to }}  {{ r.status or 301 }}
{%- endif %}
{%- endfor %}
/www/*  /:splat  301
